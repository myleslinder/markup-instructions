							},
							"children": [
								{
									"type": "Symbol",
									"tag": "checked"
								}
							]
						},
						" ",
						"convert does no type or validity check on amount",
						{
							"type": "Text",
							"style": {
								"tone": "checked",
								"note": true,
								"added": true
							},
							"children": [
								" src: src/convert.js:12-16"
							]
